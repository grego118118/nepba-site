# Neon Postgres connection string (separate database from nepba-site is recommended)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# NextAuth
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Mapbox public token (pk.*) — used in browser
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_me

# Magic link transport. For dev, links are printed to server console when no provider is set.
# Email (optional — leave blank for console-only dev mode)
EMAIL_FROM=noreply@example.com
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# SMS (optional — Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Base URL used in magic-link emails/SMS
APP_BASE_URL=http://localhost:3100
